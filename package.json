{
  "name": "obsidian-rumdl",
  "version": "0.1.26",
  "description": "Markdown linting for Obsidian using rumdl",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint main.ts --max-warnings 0",
    "test": "node --test",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "prepare": "husky",
    "deploy": "npm run build && node deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "linter",
    "rumdl"
  ],
  "author": "rvben",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.38.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "husky": "^9.0.0",
    "obsidian": "^1.13.1",
    "tslib": "2.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "rumdl-wasm": "^0.3.2"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
